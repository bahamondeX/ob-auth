{
  "name": "@ob-auth/example-nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @oscarbahamonde/ob-auth build && nuxt dev --host localhost --port 3101",
    "build": "pnpm --filter @oscarbahamonde/ob-auth build && nuxt build",
    "typecheck": "pnpm --filter @oscarbahamonde/ob-auth build && nuxt prepare && nuxt typecheck"
  },
  "dependencies": {
    "@oscarbahamonde/ob-auth": "workspace:*",
    "nuxt": "4.7.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
