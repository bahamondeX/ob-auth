{
  "name": "@ob-auth/example-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @oscarbahamonde/ob-auth build && vite --host localhost --port 3102 --strictPort",
    "build": "pnpm --filter @oscarbahamonde/ob-auth build && vite build",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server.ts",
    "typecheck": "pnpm --filter @oscarbahamonde/ob-auth build && tsc --noEmit"
  },
  "dependencies": {
    "@oscarbahamonde/ob-auth": "workspace:*",
    "h3": "^1.15.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
