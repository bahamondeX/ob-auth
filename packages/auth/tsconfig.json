{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "server/**/*.ts", "vue/**/*.ts", "react/**/*.ts", "nuxt/index.ts"]
}
