# Copy to .env, chmod 600, and use the dedicated CDK outputs.
AWS_REGION=us-east-1
AUTH_DOMAIN=http://localhost:3000
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_SECRET_ARN=
# Local-only fallback when a Secrets Manager version cannot be read.
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
SESSION_TABLE=
SESSION_ENCRYPTION_KEY_ID=

SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=86400
ACCESS_TOKEN_SECONDS=900
REFRESH_LIFETIME_SECONDS=2592000
TICKET_SECONDS=60
OB_AUTH_REQUIRE_CONFIG=true

# Vercel production uses workload identity and a confidential AWS secret ARN.
AWS_ROLE_ARN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# Supply only after configuring dedicated providers through CDK.
GOOGLE_SECRET_ARN=
MICROSOFT_SECRET_ARN=
GITHUB_SECRET_ARN=

# CDK environment and deployment settings.
OB_AWS_ACCOUNT=
OB_PORTAL_ORIGIN=https://auth.oscarbahamonde.com
OB_VERCEL_TEAM=
OB_VERCEL_ISSUER_ARN=
OB_BUDGET_EMAIL=
OB_SES_ENABLED=false
OB_SES_FROM=
OB_GOOGLE_SECRET_ARN=
OB_MICROSOFT_SECRET_ARN=
OB_MICROSOFT_ISSUER=
OB_GITHUB_SECRET_ARN=
OB_GITHUB_ISSUER=
OB_GITHUB_AUTHORIZE_URL=
